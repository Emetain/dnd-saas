# Copy this file to .env and adjust as needed.
# .env is git-ignored and never committed.

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=dndsaas
POSTGRES_USER=dndsaas
POSTGRES_PASSWORD=dndsaas

# --- OpenAI (used from Phase 3 onwards) ---
OPENAI_API_KEY=sk-replace-me

# --- Stripe (payments) ---
# Dashboard -> Developers -> API keys (use the sk_test_ key while testing).
STRIPE_SECRET_KEY=
# Printed by `stripe listen` (local) or shown on the webhook endpoint in the dashboard (online).
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back after paying.
APP_BASE_URL=http://localhost:5173

