  "race": "Human",
  "occupation": "Burgomaster's daughter",
  "role": "Quest objective",
  "description": "A young woman hunted by Strahd.",
  "motivation": "Protect her home and escape Strahd's attention.",
  "secret": "She is the reincarnation of Tatyana.",
  "status": "ALIVE",
  "disposition": "FRIENDLY",
